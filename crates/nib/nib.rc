// Windows resources for nib.exe (compiled by build.rs). The first icon is the one Explorer,
// shortcuts and the taskbar show. Regenerate icon.ico from icon.svg when the logo changes.
1 ICON "../../assets/icon.ico"

// The app's name where Windows shows one (the taskbar's group, Task Manager, "Open with"):
// FileDescription, else the file name ("nib").
1 VERSIONINFO
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "nibble"
            VALUE "ProductName", "nibble"
            VALUE "InternalName", "nib"
            VALUE "OriginalFilename", "nib.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
