#!/usr/bin/env bash
# Run nib from the current source tree. Rebuilds only what changed (incremental `fast` profile),
# then runs it with your arguments, from your current directory.
#
#   ~/src/nibble/scripts/dev/nib some_file.py
#   ~/src/nibble/scripts/dev/nib @gpu train.py
#
# Remote daemons come from dist/daemons (built by scripts/build/build.sh); nothing is installed.
set -euo pipefail

# Resolve the repo root even when this script is reached through a symlink or alias.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
ROOT="$(cd -P "$(dirname "$src")/../.." && pwd)"

command -v cargo >/dev/null || { echo "nib: cargo not found (brew install rustup && rustup default stable)" >&2; exit 1; }

cargo build --quiet --profile fast -p nib -p nibd --manifest-path "$ROOT/Cargo.toml"

# Remote daemons are uploaded by content hash, so a stale one is reused silently and the remote
# refuses the handshake. Rebuild them when nibd's sources are newer than any of them. None built
# yet: build them once the musl targets are installed, else stay quiet (local use doesn't need
# them; scripts/build/build.sh daemons says what to install).
# A failed build is not retried on every launch: only once the sources change again.
FAILED="$ROOT/dist/.daemons-failed"
sources_newer_than() {
  [ -n "$(find "$ROOT/crates/nibd" "$ROOT/crates/nib-proto" "$ROOT/Cargo.lock" -newer "$1" -type f -print -quit)" ]
}
daemons_stale() {
  local d
  if [ -f "$FAILED" ] && ! sources_newer_than "$FAILED"; then
    return 1
  fi
  for d in "$ROOT"/dist/daemons/*/nibd; do
    if [ ! -f "$d" ]; then
      rustup target list --installed 2>/dev/null | grep -q -- '-unknown-linux-musl$'
      return
    fi
    sources_newer_than "$d" && return 0
  done
  return 1
}
if daemons_stale; then
  echo "nib: nibd sources changed; rebuilding the remote daemons (scripts/build/build.sh daemons)" >&2
  if "$ROOT/scripts/build/build.sh" daemons >&2; then
    rm -f "$FAILED"
  else
    mkdir -p "$ROOT/dist" && touch "$FAILED"
    echo "nib: remote daemons not rebuilt; ssh remotes may refuse this nib (not retried until nibd's sources change; rm $FAILED to retry now)" >&2
  fi
fi

export NIB_DAEMONS="${NIB_DAEMONS:-$ROOT/dist/daemons}"
exec "$ROOT/target/fast/nib" "$@"
